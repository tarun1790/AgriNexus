# ==============================================================================
# AgriVeda AI — Production Environment Variables
# ==============================================================================

# Application Runtime Configuration
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000
WORKERS=4
LOG_LEVEL=info

# Compute Hardware Accelerator (Auto-detects CUDA / CPU)
CUDA_VISIBLE_DEVICES=0

# Google Cloud & Gemini AI Stack (Optional - Offline Sovereign Core operates without keys)
# GOOGLE_API_KEY=your_gemini_api_key_here
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GCP_PROJECT_ID=agriveda-sovereign-dpi

# BigQuery & Earth Engine (Optional for live satellite sync)
# GEE_SERVICE_ACCOUNT=agriveda-gee@project.iam.gserviceaccount.com
